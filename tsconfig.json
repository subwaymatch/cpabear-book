{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed `baseUrl`, which @docusaurus/tsconfig still sets.
    // Unset it and resolve the `@site` alias relative to this file instead.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },

  "exclude": [".docusaurus", "build"]
}
